#!/usr/bin/env python3
"""Curses launcher for the remote tools in this repository."""
import argparse
import curses
import shutil
import subprocess
import sys

TOOLS = [
    ("Remote files", "rfiles", "Browse/upload/download remote files"),
    ("Screenshot", "rsch", "Capture a screenshot from the remote host"),
    ("Screen stream", "rscr", "Stream a remote Wayland screen"),
    ("Remote VNC", "rspy", "KDE Plasma VNC through an SSH tunnel"),
    ("SSH login", "rlogin", "Open an interactive SSH session"),
    ("Wake desktop", "rwake", "Best-effort remote wake/unlock"),
    ("Transfer ISOs", "pipe_isos", "Stream ~/Downloads/isos to remote ~/isos"),
    ("Quit", None, "Exit launcher"),
]


def main(stdscr, host):
    curses.curs_set(0)
    cursor = 0
    while True:
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        stdscr.addnstr(1, 2, f"Remote Tools — {host}", max(1, w - 4), curses.A_BOLD)
        for i, (name, _cmd, desc) in enumerate(TOOLS):
            if i + 3 >= h - 2:
                break
            attr = curses.A_REVERSE if i == cursor else curses.A_NORMAL
            stdscr.addnstr(i + 3, 2, f"{'▶' if i == cursor else ' '} {name:<18} {desc}", max(1, w - 4), attr)
        stdscr.addnstr(h - 1, 2, "↑/↓ or j/k · Enter run · q quit", max(1, w - 4), curses.A_DIM)
        stdscr.refresh()
        key = stdscr.getch()
        if key in (ord("q"), ord("Q"), 27):
            return 0
        if key in (curses.KEY_UP, ord("k")):
            cursor = (cursor - 1) % len(TOOLS)
        elif key in (curses.KEY_DOWN, ord("j")):
            cursor = (cursor + 1) % len(TOOLS)
        elif key in (10, 13, curses.KEY_ENTER):
            name, command, _ = TOOLS[cursor]
            if command is None:
                return 0
            if shutil.which(command) is None:
                stdscr.erase()
                stdscr.addnstr(2, 2, f"{command} not found on PATH. Install RemoteTools first.", max(1, w - 4))
                stdscr.addstr(4, 2, "Press any key.")
                stdscr.refresh()
                stdscr.getch()
                continue
            curses.endwin()
            argv = [command, host]
            if command == "rsch":
                argv.append("--open")
            elif command == "pipe_isos":
                argv.append("~/Downloads/isos")
            try:
                subprocess.run(argv, check=False)
            except KeyboardInterrupt:
                pass
            input(f"\n{name} finished. Press Enter to return to menu...")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("host", help="SSH host alias from ~/.ssh/config")
    args = parser.parse_args()
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        parser.error("run rtui from an interactive terminal")
    curses.wrapper(main, args.host)
