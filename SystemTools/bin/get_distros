LOCAL_DIR = os.path.expanduser("~/Downloads/isos")

def arch_tui(stdscr):
    curses.curs_set(0)
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_CYAN, -1)
    curses.init_pair(2, curses.COLOR_YELLOW, -1)

    options = ["ARM64 (Apple Silicon / M1/M2/M3)", "AMD64 (Intel/AMD x86_64)"]
    cursor = 0

    while True:
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        title = " SELECT TARGET ARCHITECTURE "
        stdscr.addstr(2, max(0, (w - len(title)) // 2), title, curses.color_pair(1) | curses.A_BOLD)

        for i, opt in enumerate(options):
            if i == cursor:
                stdscr.addstr(5 + i, 4, f"> {opt}", curses.color_pair(2) | curses.A_REVERSE)
            else:
                stdscr.addstr(5 + i, 4, f"  {opt}")

        stdscr.addstr(h - 2, 4, "[Up/Down] Select  [Enter] Confirm  [Q] Quit", curses.A_DIM)
        stdscr.refresh()

        ch = stdscr.getch()
        if ch in (ord('q'), ord('Q')):
            return None
        elif ch in (curses.KEY_UP, ord('k')):
            cursor = max(0, cursor - 1)
        elif ch in (curses.KEY_DOWN, ord('j')):
            cursor = min(len(options) - 1, cursor + 1)
        elif ch in (curses.KEY_ENTER, 10, 13):
            return options[cursor]

def distro_tui(stdscr, arch_name, distro_list):
    curses.curs_set(0)
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_CYAN, -1)
    curses.init_pair(2, curses.COLOR_GREEN, -1)
    curses.init_pair(3, curses.COLOR_YELLOW, -1)

    selected = [False] * len(distro_list)
    cursor = 0

    while True:
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        title = f" DOWNLOADER: {arch_name} "
        stdscr.addstr(1, max(0, (w - len(title)) // 2), title, curses.color_pair(1) | curses.A_BOLD)

        stdscr.addstr(3, 2, f"Local Save: {LOCAL_DIR}")
        stdscr.addstr(4, 2, "-" * (w - 4))

        for i, (name, url, filename) in enumerate(distro_list):
            checkbox = "[x]" if selected[i] else "[ ]"
            line = f"{checkbox} {name}"
            if i == cursor:
                stdscr.addstr(6 + i, 2, line, curses.color_pair(3) | curses.A_REVERSE)
            elif selected[i]:
                stdscr.addstr(6 + i, 2, line, curses.color_pair(2))
            else:
                stdscr.addstr(6 + i, 2, line)

        footer_y = min(h - 2, 6 + len(distro_list) + 1)
        stdscr.addstr(footer_y, 2, "[Space] Toggle  [A] All  [N] None  [D] Download  [Q] Quit", curses.A_DIM)
        stdscr.refresh()

        ch = stdscr.getch()
        if ch in (ord('q'), ord('Q')):
            return None
        elif ch in (curses.KEY_UP, ord('k')):
            cursor = max(0, cursor - 1)
        elif ch in (curses.KEY_DOWN, ord('j')):
            cursor = min(len(distro_list) - 1, cursor + 1)
        elif ch == ord(' '):
            selected[cursor] = not selected[cursor]
        elif ch in (ord('a'), ord('A')):
            selected = [True] * len(distro_list)
        elif ch in (ord('n'), ord('N')):
            selected = [False] * len(distro_list)
        elif ch in (ord('d'), ord('D')):
            if not any(selected):
                continue
            return [distro_list[i] for i, val in enumerate(selected) if val]

def main():
    print("Starting Architecture Selection...")
    arch = curses.wrapper(arch_tui)
    if not arch:
        print("No architecture selected. Exiting.")
        return

    if "ARM64" in arch:
        distro_list = ARM64_ISOS
    else:
        distro_list = AMD64_ISOS

    print(f"Starting TUI for {arch}...")
    selected_isos = curses.wrapper(distro_tui, arch, distro_list)

    if not selected_isos:
        print("No distros selected. Exiting.")
        return

    os.makedirs(LOCAL_DIR, exist_ok=True)
    downloaded_files = []

    print(f"\nStarting download of {len(selected_isos)} distros to {LOCAL_DIR}...")

    for name, url, filename in selected_isos:
        local_path = os.path.join(LOCAL_DIR, filename)
        print(f"\n=======================================================")
        print(f"--> Downloading: {name}")
        print(f"--> Destination: {local_path}")
        print(f"=======================================================")

        cmd = ["curl", "-fL", "--progress-bar", "-o", local_path, "--", url]
        try:
            subprocess.run(cmd, check=True)
            print(f"[SUCCESS] {filename} saved locally.")
            downloaded_files.append((filename, local_path))
        except subprocess.CalledProcessError as e:
            print(f"\n[ERROR] Failed to download {name}. Exit code: {e.returncode}")

    if not downloaded_files:
        print("\nNo files were downloaded successfully. Exiting.")
        return

    print("\n=======================================================")
    print("ALL DOWNLOADS COMPLETE.")
    print("=======================================================")

    remote_host = input("Enter SSH host to copy these files to (e.g., 'my-host'), or press Enter to keep local only: ").strip()
    if remote_host.startswith("-"):
        print("Invalid SSH host: use a configured SSH alias or user@host.")
        return
    if not remote_host:
        print(f"\nKeeping files locally in {LOCAL_DIR}. Done.")
        return

    print(f"\n--> Preparing {remote_host}:~/isos ...")
    check = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", remote_host, "mkdir -p ~/isos"])
    if check.returncode != 0:
        print(f"\n[ERROR] Cannot connect to '{remote_host}' via SSH. Files remain local.")
        return

    for filename, local_path in downloaded_files:
        print(f"\n--> Transferring {filename} to {remote_host}...")
        scp_cmd = ["scp", "-c", "aes128-gcm@openssh.com", "--", local_path, f"{remote_host}:~/isos/"]
        try:
            subprocess.run(scp_cmd, check=True)
            print(f"[SUCCESS] {filename} copied to {remote_host}.")
        except subprocess.CalledProcessError as e:
            print(f"\n[ERROR] Failed to copy {filename}. Exit code: {e.returncode}")

if __name__ == "__main__":
    main()
