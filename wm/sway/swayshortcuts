#!/usr/bin/env python3
"""Print key bindings from the active user's Sway configuration."""
import argparse
import glob
import os
import re
from pathlib import Path

MODS = {"$mod": "Mod", "Mod4": "Super", "Mod1": "Alt", "Control": "Ctrl", "Ctrl": "Ctrl", "Shift": "Shift", "Mod2": "Mod2", "Mod3": "Mod3", "Mod5": "Mod5"}


def config_path():
    candidates = [Path(os.environ.get("XDG_CONFIG_HOME", "~/.config")).expanduser() / "sway/config", Path("/etc/sway/config")]
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    raise FileNotFoundError("could not find ~/.config/sway/config or /etc/sway/config")


def read_config(path, seen=None):
    seen = seen or set()
    path = path.expanduser().resolve()
    if path in seen or not path.is_file():
        return []
    seen.add(path)
    lines = []
    for raw in path.read_text(errors="replace").splitlines():
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        m = re.match(r"^include\s+(.+?)\s*$", stripped)
        if m:
            inc = m.group(1).strip().strip("\"'")
            inc = os.path.expandvars(os.path.expanduser(inc))
            if not os.path.isabs(inc):
                inc = str(path.parent / inc)
            matches = [Path(item) for item in sorted(glob.glob(inc))] if any(c in inc for c in "*?[") else [Path(inc)]
            for child in matches:
                lines.extend(read_config(child, seen))
            continue
        lines.append((path, stripped))
    return lines


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--config", type=Path, help="Sway config path (defaults to user's config)")
    ap.add_argument("--raw", action="store_true", help="show original binding commands")
    args = ap.parse_args()
    try:
        lines = read_config(args.config or config_path())
    except OSError as exc:
        ap.error(str(exc))
    mode = "default"
    found = []
    for path, line in lines:
        mm = re.match(r"^mode\s+['\"]?([^'\"]+)['\"]?\s*\{?", line)
        if mm:
            mode = mm.group(1)
            continue
        if line == "}":
            mode = "default"
            continue
        m = re.match(r"^(bindsym|bindcode)\s+(?:--[^\s]+\s+)*([^\s]+)\s+(.+)$", line)
        if not m:
            continue
        kind, key, command = m.groups()
        if args.raw:
            readable = f"{kind} {key} {command}"
        else:
            readable = key.replace("+", " + ")
            for old, new in MODS.items():
                readable = re.sub(rf"(?<![A-Za-z0-9_]){re.escape(old)}(?![A-Za-z0-9_])", new, readable)
            readable = f"{readable:<26} {command}"
        found.append((mode, readable))
    if not found:
        print("No bindsym/bindcode bindings found.")
        return 0
    print("\033[1mSway key bindings\033[0m")
    last_mode = None
    for mode, binding in sorted(found, key=lambda x: (x[0] != "default", x[0].lower(), x[1].lower())):
        if mode != last_mode:
            print(f"\n\033[1m[{mode}]\033[0m")
            last_mode = mode
        print("  " + binding)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
